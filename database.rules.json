{
  "rules": {
    "acct": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rank": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 1000 && newData.child('name').isString() && newData.child('name').val().length <= 10"
      }
    },
    "lobby": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$ch": {
        ".read": "auth != null && ($ch === 'ch-gangnam' || $ch === 'ch-seocho')",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($ch === 'ch-gangnam' || $ch === 'ch-seocho')",
          "hit": {
            ".validate": "auth.token.email === 'ADMIN_EMAIL(콘솔에만 실제 관리자 Gmail을 넣음)' && auth.token.email_verified === true"
          }
        }
      }
    }
  }
}